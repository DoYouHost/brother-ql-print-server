<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Announces the print server over mDNS/DNS-SD so apps can find it without an address.
     Install as /etc/avahi/services/label-printer.service (Avahi picks it up by itself).
     Keep port, model and label in step with server.py (a test checks this). -->
<service-group>
  <name replace-wildcards="yes">Label printer on %h</name>
  <service>
    <type>_labelprinter._tcp</type>
    <port>8000</port>
    <txt-record>v=1</txt-record>
    <txt-record>path=/info</txt-record>
    <txt-record>model=QL-600</txt-record>
    <txt-record>label=62x29</txt-record>
    <txt-record>dpi=300</txt-record>
  </service>
</service-group>
